# Separate news publisher bot settings.
# Fill these values, then run: npm run news-bot

# General
NEWS_BOT_INTERVAL_MINUTES=30
NEWS_BOT_MAX_POSTS_PER_RUN=1
NEWS_BOT_RUN_ONCE=false
NEWS_BOT_DRY_RUN=true
NEWS_BOT_STATE_FILE=.news-bot-state.json

# Search filters
NEWS_BOT_KEYWORDS=ton,ton community,toncoin,the open network,telegram open network,ton foundation
NEWS_BOT_EXCLUDE_KEYWORDS=buy,price,pricing,value,advice,prediction,forecast,outlook,presale,performing better,venmo,kabul university,blockdag,zcash
NEWS_BOT_ALLOWED_SOURCES=TON,TON Blog,TON Foundation,The Open Network,CoinGecko
NEWS_BOT_FEED_URLS=https://news.google.com/rss/search?q=(site%3Ablog.ton.org%20OR%20site%3Aton.org%20OR%20site%3Acoingecko.com)%20(TON%20OR%20Toncoin%20OR%20%22The%20Open%20Network%22%20OR%20CoinGecko)&hl=en-US&gl=US&ceid=US:en

# Telegram
# Add the bot as admin to the channel/group.
# TELEGRAM_NEWS_CHAT_ID can be @channel_username or a numeric chat id.
