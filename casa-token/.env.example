PORT=3000
NODE_ENV=development
# TON Connect wallets must fetch this URL from the public internet.
# Use an HTTPS domain or tunnel, for example: https://your-domain.com
PUBLIC_URL=http://localhost:3000
SOCIAL_X_URL=https://x.com/casafond
INITIAL_PRICE=0.001247
PRICE_VOLATILITY=0.0003
PRICE_UPDATE_INTERVAL=5000
CONTRACT_ADDRESS=EQBWK_VVEBJWiIQIIXOckUVw0HdF24buJiNiiR0dUHEe2xs4
# Required for production STON.fi quotes. This must be the real CASA jetton master address.
CASA_JETTON_ADDRESS=EQBWK_VVEBJWiIQIIXOckUVw0HdF24buJiNiiR0dUHEe2xs4
# Use stonfi for real quote simulation, demo for local mock quotes.
DEX_PROVIDER=stonfi
STONFI_ROUTER_ADDRESS=
DEDUST_FACTORY_ADDRESS=

# Optional PostgreSQL persistence for Telegram bot alerts, referrals, and subscriptions.
# Without this value, bot state is stored in memory and resets on restart.
DATABASE_URL=
# Set false for local PostgreSQL without TLS. Production usually uses true/auto.
DATABASE_SSL=

# Minimum USD value for Telegram whale alerts.
WHALE_THRESHOLD_USD=1000

# Telegram bot integration.
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Use true for local development without a public HTTPS webhook.
TELEGRAM_BOT_POLLING=false
# Use a long random value. Webhook URL will be:
# https://your-domain.com/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_WEBHOOK_SECRET=change-this-long-random-secret
# Optional admin secret for /api/telegram/set-webhook and /api/telegram/webhook-info.
TELEGRAM_ADMIN_SECRET=change-this-admin-secret

# Separate news publisher bot.
# Run with: npm run news-bot
NEWS_BOT_INTERVAL_MINUTES=30
NEWS_BOT_MAX_POSTS_PER_RUN=2
NEWS_BOT_RUN_ONCE=false
NEWS_BOT_DRY_RUN=true
NEWS_BOT_KEYWORDS=ton,ton community,toncoin,the open network,telegram open network,ton foundation
NEWS_BOT_EXCLUDE_KEYWORDS=buy,price,pricing,value,advice,prediction,forecast,outlook,presale,performing better,venmo,kabul university,blockdag,zcash
NEWS_BOT_ALLOWED_SOURCES=TON,TON Blog,TON Foundation,The Open Network,CoinGecko
NEWS_BOT_FEED_URLS=https://news.google.com/rss/search?q=(site%3Ablog.ton.org%20OR%20site%3Aton.org%20OR%20site%3Acoingecko.com)%20(TON%20OR%20Toncoin%20OR%20%22The%20Open%20Network%22%20OR%20CoinGecko)&hl=en-US&gl=US&ceid=US:en
NEWS_BOT_TWEET_TAGS="#TON #CoinGecko"
NEWS_BOT_STATE_FILE=.news-bot-state.json

# Telegram channel/chat for the separate news publisher.
# For a channel, add the bot as admin and use @channel_username or numeric chat id.
TELEGRAM_NEWS_BOT_TOKEN=
TELEGRAM_NEWS_CHAT_ID=

# X/Twitter app credentials with write permission.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
